{
  "name": "lifeos",
  "version": "0.0.0",
  "private": true,
  "description": "Personal LifeOS monorepo.",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/tma/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test:workers": "python3 -m unittest discover -s workers -p test_worker_suite.py",
    "test:all": "pnpm test && pnpm test:workers",
    "selfhost:build-tma": "bash scripts/build-tma-selfhost.sh",
    "selfhost:deploy": "bash scripts/deploy-selfhost.sh",
    "selfhost:status": "bash scripts/status-selfhost.sh"
  },
  "devDependencies": {
    "@types/node": "^22.15.19",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "browserslist@<4.28.7": "^4.28.7",
      "@babel/core@>=7.0.0 <7.29.6": "7.29.6",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "postcss-selector-parser@>=6.0.0 <6.1.5": "6.1.5"
    }
  }
}
