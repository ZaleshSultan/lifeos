# Public browser origin/base path; must match LIFEOS_WEB_URL on the bot.
# Use HTTPS in production. The app is served under /web.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3001/web
# Server-only backend URL for exchange, live authorization and revocation.
# Use HTTPS in production. Do not add service-role or signing secrets here.
LIFEOS_API_BASE_URL=http://localhost:3000
