TMA_APP_URL=https://example.com/tma/
TELEGRAM_BOT_USERNAME=replace-with-telegram-bot-username
VITE_API_BASE_URL=http://localhost:3000
# Self-host build uses same origin and /tma/ via build-tma-selfhost.sh.
VITE_BASE_PATH=/
