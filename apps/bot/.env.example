NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
TELEGRAM_WEBAPP_URL=https://example.com
TMA_URL=https://example.com
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://example.com/api/oauth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-random-oauth-state-secret
# Personal web login links generated by /web. Use the public Next.js web URL.
LIFEOS_WEB_URL=https://web.example.com
# Generate with: openssl rand -base64 32
LIFEOS_WEB_SESSION_SECRET=replace-with-random-web-session-secret
LIFEOS_OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-random-secret
LIFEOS_HEALTH_INGEST_JWT_SECRET=replace-with-random-health-jwt-secret
SYNCTHING_API_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY=replace-with-local-syncthing-api-key
SYNCTHING_SERVER_DEVICE_ID=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
# Health ingest is JWT-only. Use POST /api/tma/health/ingest-token from TMA.
LIFEOS_ADMIN_TELEGRAM_IDS=123456789
LIFEOS_SIGNUP_MODE=pending_approval
LIFEOS_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
LIFEOS_DEFAULT_TELEGRAM_USER_ID=123456789
ALLOW_UNSAFE_TMA_DEV_AUTH=false

# Optional internal LifeOS AI. Trusted backend only; never use VITE_/NEXT_PUBLIC_.
GEMINI_API_KEY=
LIFEOS_AI_ENABLED=false
LIFEOS_AI_TEXT_MODEL=gemini-3.8-flash
# Reserved Live configuration: voice is not implemented in this release.
LIFEOS_AI_LIVE_MODEL=gemini-3.1-flash-live-preview
LIFEOS_AI_LIVE_ENABLED=false
LIFEOS_AI_TIMEOUT_MS=15000
LIFEOS_AI_REQUESTS_PER_MINUTE=6
LIFEOS_AI_REQUESTS_PER_DAY=40
LIFEOS_AI_GLOBAL_REQUESTS_PER_DAY=200
LIFEOS_AI_MAX_CONCURRENT=4
LIFEOS_AI_MAX_TRACKED_USERS=2000
LIFEOS_AI_MAX_CONTEXT_CHARS=30000
LIFEOS_AI_MAX_OUTPUT_TOKENS=2048

# Optional assistant tools and explicit memory. Apply the additive assistant
# migration through the normal approved release process before enabling.
LIFEOS_ASSISTANT_ENABLED=false
# Backend-only random secret (at least 32 characters) for TMA write confirmation.
LIFEOS_ASSISTANT_CONFIRMATION_SECRET=
# Permanent memory deletion stays disabled until explicitly enabled.
LIFEOS_ASSISTANT_MEMORY_DELETE_ENABLED=false
# Reuses the existing Gemini service and quotas; no new provider credentials.
LIFEOS_ASSISTANT_CLASSIFICATION_ENABLED=false

# AITU session validation reuses the Python Moodle client. Backend only.
# Self-host: use the existing aitu-parser venv (install requirements first).
LIFEOS_LMS_PYTHON=python3
# App retention cap; Microsoft can invalidate the session earlier. Allowed 1..168.
LIFEOS_LMS_SESSION_TTL_HOURS=24
# ENCRYPTION_KEY must be the same valid 32-byte key on bot and LMS worker.
# No plaintext fallback; never put cookies in environment examples or VITE_*.

# Exact browser origins, comma-separated. Include the public origin behind a TLS proxy.
# Empty permits direct same-origin and server-to-server requests only; no wildcards.
LIFEOS_CORS_ALLOWED_ORIGINS=

# Shared external AI safety (does not enable a provider). Durable accounting migration required.
LIFEOS_AI_KILL_SWITCH=false
LIFEOS_AI_EXECUTION_TIMEOUT_MS=20000
LIFEOS_AI_EXECUTION_MAX_CONCURRENT=2
LIFEOS_AI_MAX_REQUEST_TOKENS=100000
LIFEOS_AI_EXECUTION_MAX_OUTPUT_TOKENS=8192
LIFEOS_AI_USER_DAILY_TOKENS=200000
LIFEOS_AI_FEATURE_DAILY_TOKENS=100000
LIFEOS_AI_GLOBAL_DAILY_TOKENS=1000000
LIFEOS_AI_MAX_TASK_ITERATIONS=3
LIFEOS_AI_CIRCUIT_FAILURES=3
LIFEOS_AI_CIRCUIT_COOLDOWN_MS=60000
# Optional estimated monetary caps in USD millionths. Require both configured rates.
LIFEOS_AI_USER_DAILY_COST_MICROS=
LIFEOS_AI_FEATURE_DAILY_COST_MICROS=
LIFEOS_AI_GLOBAL_DAILY_COST_MICROS=
LIFEOS_AI_ESTIMATED_INPUT_MICROS_PER_1K=
LIFEOS_AI_ESTIMATED_OUTPUT_MICROS_PER_1K=

# Optional consented meal-photo estimates. Enable only after the existing vision
# model/account and its spending caps have been verified. Manual food logging
# works independently. Uses GEMINI_API_KEY and LIFEOS_AI_TEXT_MODEL above.
LIFEOS_MEAL_VISION_ENABLED=false
# Optional full reviewed commit SHA reported by /healthz; not a credential.
LIFEOS_RELEASE_SHA=

# Unified model routing stays inert until operator configuration and owner consent.
# JSON contains metadata/env-variable references only; never paste keys into UI/chat.
LIFEOS_AI_ROUTER_ENABLED=false
# Optional free-only profile. Never enables the router or provider consent itself.
LIFEOS_AI_ROUTER_FREE_PROFILE_ENABLED=false
LIFEOS_AI_ROUTER_PAID_REQUESTS_ENABLED=false
LIFEOS_AI_ROUTER_MAX_REQUEST_COST_MICROS=0
LIFEOS_AI_ROUTER_MAX_DAILY_COST_MICROS=0
LIFEOS_AI_ROUTER_MAX_OUTPUT_TOKENS=2048
LIFEOS_AI_ROUTER_CREDENTIALS_JSON=[]
LIFEOS_AI_ROUTER_MODELS_JSON=[]

# Capture external processing requires per-record confirmation and existing owner
# router/privacy/budget authorization. Classification-scoped credentials only.
# A configured key is not consent. Keep both disabled until authorized testing.
LIFEOS_CAPTURE_AI_EXTRACTION_ENABLED=false
LIFEOS_CAPTURE_TRANSCRIPTION_ENABLED=false

# Scheduling capability; every owner/category still requires explicit saved opt-in.
LIFEOS_ACADEMIC_NOTIFICATIONS_ENABLED=false
