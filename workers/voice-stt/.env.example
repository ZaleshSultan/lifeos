# Private loopback worker. Use the same random secret in the bot environment.
LIFEOS_VOICE_WORKER_SECRET=replace_with_32_or_more_random_urlsafe_characters
LIFEOS_VOICE_WORKER_PORT=8091
LIFEOS_VOICE_MODEL=tiny
LIFEOS_VOICE_LANGUAGE=auto
LIFEOS_VOICE_CPU_THREADS=2
LIFEOS_VOICE_MAX_BYTES=4194304
LIFEOS_VOICE_MAX_SECONDS=90
LIFEOS_VOICE_WORKER_TIMEOUT_SECONDS=60
# Optional pre-downloaded faster-whisper cache. Loading is local-only.
LIFEOS_VOICE_MODEL_CACHE=
