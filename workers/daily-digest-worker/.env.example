SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TMA_URL=https://lifeos.example.com/tma/
APP_TIMEZONE=Asia/Almaty
DAILY_DIGEST_TIME=08:00
DAILY_DIGEST_POLL_SECONDS=60
DAILY_DIGEST_SEND_WINDOW_MINUTES=720
# Optional: during setup, restrict sends to one Telegram user id.
DAILY_DIGEST_TEST_TELEGRAM_USER_ID=

# Optional fallback weather only for users who did not run /weather <city>.
# For a truly per-user setup leave all three blank.
LIFEOS_DEFAULT_WEATHER_NAME=
LIFEOS_DEFAULT_WEATHER_LATITUDE=
LIFEOS_DEFAULT_WEATHER_LONGITUDE=
