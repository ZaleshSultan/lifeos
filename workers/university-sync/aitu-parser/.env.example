# ── Supabase (required) ───────────────────────────────────────────────────────
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
LIFEOS_DEFAULT_USER_ID=replace-with-user-uuid
APP_TIMEZONE=Asia/Qyzylorda

# ── Legacy single-user guard (must be 'true' for local/dev use) ───────────────
LIFEOS_ENABLE_LEGACY_SINGLE_USER_UNIVERSITY_SYNC=false

# ── AITU LMS credentials ──────────────────────────────────────────────────────
# Primary: Moodle local account credentials for form-based login.
UNIVERSITY_USERNAME=your_student_id_or_email
UNIVERSITY_PASSWORD=your_password

# Optional: Moodle Web Services token (most reliable; avoids HTML scraping).
# Generate at: https://lms.astanait.edu.kz/user/managetoken.php
# Required capabilities: gradereport/user:view, moodle/grade:view
# Leave blank to fall back to session-based scraping.
UNIVERSITY_WS_TOKEN=

# ── Polling ───────────────────────────────────────────────────────────────────
# Interval between sync runs in run-loop mode (seconds). Default: 3600 (1 hour).
UNIVERSITY_SYNC_POLL_SECONDS=3600
