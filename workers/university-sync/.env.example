# ── Supabase (required) ───────────────────────────────────────────────────────
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# LIFEOS_DEFAULT_USER_ID is not used by this multi-tenant worker.
# It is intentionally absent.

APP_TIMEZONE=Asia/Qyzylorda

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte AES-256 key shared with TypeScript @lifeos/db/crypto-at-rest.
# Provide as a 64-char hex string OR base64(32 bytes).
# Missing/invalid keys fail closed: no plaintext credential fallback.
# Canonical ciphertext is enc:v1:<base64url-IV>:<base64url-tag>:<base64url-body>.
ENCRYPTION_KEY=replace-with-64-hex-char-or-base64-32byte-key

# ── Polling ───────────────────────────────────────────────────────────────────
# Automatic per-integration refresh interval. Default: 14400 (4 hours).
# The worker polls every <=30 seconds for authenticated manual sync requests
# and expired-session cleanup, including inactive integrations.
UNIVERSITY_GLOBAL_POLL_SECONDS=14400

# Session retention is configured on apps/bot via LIFEOS_LMS_SESSION_TTL_HOURS:
# default 24 hours, range 1..168 hours. Workers honor session_expires_at and scrub
# expired/rejected cookies; never place UNIVERSITY_SSO_COOKIE in this worker env.
# Both legacy and multi-user workers require the secure LMS migration and use
# the same per-user/platform lease; this file never changes existing services.
