SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
LIFEOS_ENABLE_LEGACY_SINGLE_USER_OBSIDIAN=false
# Legacy dashboard initialization only; queue processing uses per-user DB settings.
# Must be explicitly bound to LIFEOS_DEFAULT_USER_ID (canonical UUID).
LIFEOS_DEFAULT_USER_ID=replace-with-canonical-user-uuid
OBSIDIAN_VAULT_PATH=/srv/obsidian-vault
OBSIDIAN_MIRROR_BATCH_SIZE=10
OBSIDIAN_MIRROR_INTERVAL_SECONDS=30
OBSIDIAN_MIRROR_DASHBOARD_DIR=Dashboards
