+def _schedule_start_minutes(row: JsonObject) -> int:
+    raw = str(row.get("start_time") or "")
+    try:
+        hour, minute = (int(part) for part in raw[:5].split(":", 1))
+        return hour * 60 + minute
+    except (TypeError, ValueError):
+        return 24 * 60
+
+
+def first_class_line(
+    local_now: datetime,
+    courses: list[JsonObject],
+    schedule: list[JsonObject],
+) -> str:
+    if not schedule:
+        return "<b>🎓 Сегодня пар нет</b>"
+
+    course_map = {str(course.get("id")): course for course in courses}
+    first = min(schedule, key=_schedule_start_minutes)
+    course = course_map.get(str(first.get("study_course_id")), {})
+    title = html.escape(str(course.get("title") or course.get("code") or "Предмет"))
+    start = str(first.get("start_time") or "")[:5] or "—"
+    room = str(first.get("room") or "").strip()
+    suffix = f" · {html.escape(room)}" if room else ""
+
+    start_minutes = _schedule_start_minutes(first)
+    now_minutes = local_now.hour * 60 + local_now.minute
+    delta = start_minutes - now_minutes
+    if 0 < delta < 24 * 60:
+        hours, minutes = divmod(delta, 60)
+        if hours and minutes:
+            until = f" · через {hours} ч {minutes} мин"
+        elif hours:
+            until = f" · через {hours} ч"
+        else:
+            until = f" · через {minutes} мин"
+    else:
+        until = ""
+
+    return f"<b>🚨 Первая пара: {html.escape(start)} — {title}{suffix}</b>{until}"
+
