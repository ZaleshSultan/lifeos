+#!/usr/bin/env bash
+set -euo pipefail
+
+TARGET_TIME="${1:-06:00}"
+if [[ ! "$TARGET_TIME" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
+  echo "Usage: $0 [HH:MM]" >&2
+  exit 2
+fi
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+ENV_FILE="$ROOT_DIR/workers/daily-digest-worker/.env"
+EXAMPLE_FILE="$ROOT_DIR/workers/daily-digest-worker/.env.example"
+
+if [[ ! -f "$ENV_FILE" ]]; then
+  if [[ ! -f "$EXAMPLE_FILE" ]]; then
+    echo "Missing $EXAMPLE_FILE" >&2
+    exit 1
+  fi
+  cp "$EXAMPLE_FILE" "$ENV_FILE"
+  chmod 600 "$ENV_FILE"
+fi
+
+if grep -q '^DAILY_DIGEST_TIME=' "$ENV_FILE"; then
+  sed -i "s/^DAILY_DIGEST_TIME=.*/DAILY_DIGEST_TIME=$TARGET_TIME/" "$ENV_FILE"
+else
+  printf '\nDAILY_DIGEST_TIME=%s\n' "$TARGET_TIME" >> "$ENV_FILE"
+fi
+
+echo "Daily digest time set to $TARGET_TIME"
+
+if command -v systemctl >/dev/null 2>&1 && systemctl cat lifeos-daily-digest.service >/dev/null 2>&1; then
+  sudo systemctl restart lifeos-daily-digest.service
+  sudo systemctl --no-pager --full status lifeos-daily-digest.service | sed -n '1,12p'
+else
+  echo "lifeos-daily-digest.service is not installed; restart your worker manually."
+fi
